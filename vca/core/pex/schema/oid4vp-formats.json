{
  "$comment": "VCA extension of claim-format-designations.json. OpenID for Verifiable Presentations names these credential formats in a presentation definition. The upstream registry file does not list them.",
  "patternProperties": {
    "^jwt_vc_json$|^jwt_vp_json$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "^vc\\+sd-jwt$|^dc\\+sd-jwt$": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sd-jwt_alg_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "kb-jwt_alg_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
