# Copy this to `.env` and edit for your environment. Docker Compose
# reads `.env` automatically from the same directory as the compose
# file. The seed scripts under docker/injiweb/ also source this file.
#
# The ONE variable you almost always need to change for a non-laptop
# deployment is PUBLIC_HOST.

# -----------------------------------------------------------------------------
# Browser-visible hostname for ALL public URLs the user follows in a browser
# (Inji Web UI, eSignet oidc-ui, vcplatform Go app). Must ALSO be reachable
# from inside containers on the waltid_default docker network, because
# Mimoto reads esignet's advertised token endpoint URL directly out of
# esignet's well-known and posts to it from inside its container.
#
# Laptop (browser on the same host as Docker):
#     PUBLIC_HOST=172.24.0.1
#   — the waltid_default bridge gateway IP. Published ports are bound on
#     0.0.0.0, so both the browser AND Mimoto's container reach the
#     oidc-ui container via 172.24.0.1:3005.
#
# EC2 / remote host (browser on a different machine than Docker):
#     PUBLIC_HOST=<ec2-public-hostname-or-ip>
#   — the EC2 instance's public address. From the browser it reaches
#     the published ports; from inside Mimoto's container it resolves
#     to the host's external interface and loops back through docker's
#     port forward. If the EC2 is using a private IP, use that.
#
# Docker Desktop / Linux with /etc/hosts entry:
#     PUBLIC_HOST=host.docker.internal
#   — only if you've added `127.0.0.1 host.docker.internal` to your
#     host's /etc/hosts. Docker Desktop does this automatically; native
#     Linux Docker does not.
PUBLIC_HOST=172.24.0.1

# Port the browser uses to reach the eSignet oidc-ui container. The
# container internally listens on :3000 and is mapped to host :3005
# by default. Change here only if :3005 is already in use on your host.
ESIGNET_PUBLIC_PORT=3005

# Port the browser uses to reach the Inji Web UI container. The
# container listens on :3004 and is mapped to host :3004.
INJIWEB_UI_PUBLIC_PORT=3004

# Password and alias for the wallet-demo-client PKCS12 keystore that
# Mimoto uses to sign private_key_jwt assertions to esignet. These
# must match the p12 at docker/injiweb/config/certs/oidckeystore.p12.
# See docker/injiweb/README.md for how to replace the keystore.
INJIWEB_P12_PASSWORD=xy4gh6swa2i

# Google OAuth creds for Mimoto's wallet-backup-to-Drive feature.
# Dummy values are fine for local demos — Mimoto logs a warning and
# continues without the backup feature.
GOOGLE_OAUTH_CLIENT_ID=dummy-client-id
GOOGLE_OAUTH_CLIENT_SECRET=dummy-client-secret


VERIFIABLY_PUBLIC_DOMAIN=verifiably.ysalabs.work
VERIFIABLY_HOSTS_PATTERN=https://%s.verifiably.ysalabs.work
VERIFIABLY_LE_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Issuer display name — the friendly issuer label a wallet shows when it
# reads the credential-issuer metadata (OID4VCI top-level `display[].name`).
#
# This single value propagates to all three issuer backends:
#   • Inji Certify      → mosip.certify.credential-config.issuer.display
#                         (certify-csvdp-farmer*.properties), surfaced in the
#                         PUBLIC /.well-known/openid-credential-issuer document
#   • Inji Web wallet   → issuer selector card (mimoto-issuers-config)
#   • CREDEBL           → ISSUER field in credebl.env (written by deploy.sh)
#
# To change the issuer name tag: set it here (uncomment + edit) and re-run
# `./deploy.sh up <scenario>` — or, on a live box, recreate the affected
# backend(s), e.g.:
#   ISSUER_DISPLAY_NAME="Your Org" docker compose -p waltid \
#     -f deploy/compose/stack/docker-compose.yml --env-file .env \
#     up -d --force-recreate --no-deps inji-certify-preauth-backend
# Verify: curl -sk https://inji-certify-preauth.<domain>/.well-known/openid-credential-issuer | jq .display
#
# Leave blank to keep the built-in demo value ("VC Infra Issuer" / "CDPI").
ISSUER_DISPLAY_NAME=

# -----------------------------------------------------------------------------
# Federation: did:web issuer domain
#
# Leave blank for local dev — Inji Certify uses Docker-internal hostnames
# (did:web:certify-nginx, did:web:certify-preauth-nginx) that only resolve
# inside the Docker network. Credentials still issue and verify correctly.
#
# Set to your public domain to make this deployment federation-ready and
# eligible to join the Hub's Trust Registry:
#
#   ISSUER_DID_DOMAIN=issuer.gov
#
# Effect when set:
#   • Inji Certify (primary)   → issues credentials with issuer: did:web:issuer.gov
#   • Inji Certify (pre-auth)  → same DID (did:web:issuer.gov); inji_proxy merges
#                                 both instances' keys into one DID Document
#   • /.well-known/did.json    → must be publicly reachable at https://issuer.gov
#     (Caddy proxies this automatically when VERIFIABLY_PUBLIC_DOMAIN=issuer.gov)
#
# CREDEBL did:web: CREDEBL provisions its DID through its Aries agent at first
# run; changing the method requires re-provisioning the agent. See
# deploy/compose/credebl/config/credebl.env for details.
ISSUER_DID_DOMAIN=

# -----------------------------------------------------------------------------
# Inji Certify Pre-Auth public URL.
#
# JwtProofValidator (Nimbus) validates the wallet's proof JWT aud claim against
# this value. The wallet sets aud = credential_issuer (the public URL it read
# from /.well-known/openid-credential-issuer), so this MUST be the externally
# reachable base URL for the certify-preauth-nginx container.
#
# Local dev (default): leave unset — mosip_certify_domain_url defaults to the
# Docker-internal hostname, and OID4VCI wallets on the same LAN/host can still
# reach the endpoints.
#
# Production / remote host: set to the full https URL Caddy serves for
# certify-preauth-nginx, e.g.:
#   PREAUTH_PUBLIC_URL=https://inji-certify-preauth.yourdomain.com
#
# PREAUTH_JWKS_URI must stay as the INTERNAL Docker address so the backend can
# fetch its own JWKS without hairpin NAT. Do not change this default.
PREAUTH_PUBLIC_URL=
PREAUTH_JWKS_URI=http://inji-certify-preauth:8090/v1/certify/.well-known/jwks.json

# -----------------------------------------------------------------------------
# issuer-api2 (mdoc/mDL issuance) — required at boot, no silent fallback.
#
# issuer-api2 ships with THREE private keys published in walt.id's public
# GitHub repository baked into its default config. All three must be
# replaced before this service is usable for anything real; the compose
# definition refuses to start (via ${VAR:?...}) if any is unset.

# EC P-256 issuer key. Signs the mdoc's COSE_Sign1.
# mdoc REQUIRES EC — Ed25519 is rejected with: The key type "kty" must be EC
#
# Supplied as THREE SEPARATE base64url coordinates, not as one JWK JSON blob.
# issuer2-profiles.conf needs defaultIssuerKey.jwk to be a HOCON *object*, and
# a substituted env var is always a *string* — HOCON never re-parses it as
# JSON. The single-variable blob form booted cleanly and showed up correctly
# in GET /issuer2/profiles, but made EVERY credential request fail with
#   500 {"error":"server_error","error_description":"Invalid JSON object"}
# Do not collapse these three back into one JSON variable, and do not verify a
# change here by booting alone — only a real issuance proves it.
#
# (Note this differs from the two keys below, which genuinely DO take a
# one-line JSON string. Same-looking syntax, opposite requirement.)
#
# Generate:
#   openssl ecparam -name prime256v1 -genkey -noout -out issuer2-key.pem
#   # then export the JWK and copy its x, y and d values into the three
#   # variables below (base64url, no padding)
# Never commit the values. walt.id's shipped default is a private key published
# in their public repo and must not be used for anything real.
#
# NOTE: replacing this key alone is NOT sufficient for trustworthy mdoc
# issuance — see the "HARD GATE" comment above defaultIssuerX5chain in
# deploy/k8s/config/issuer2/issuer2-profiles.conf. The shipped x5Chain
# certificate still advertises walt.id's OLD published public key, and a
# conformant ISO 18013-5 reader verifies against that certificate, not
# against this key. Until the certificate is replaced (tracked in
# docs/superpowers/specs/2026-07-23-issuer-key-rotation-design.md), every
# mdoc this service issues will fail signature verification everywhere real.
VERIFIABLY_ISSUER2_KEY_X=
VERIFIABLY_ISSUER2_KEY_Y=
VERIFIABLY_ISSUER2_KEY_D=

# EC P-256 key used to sign issuer-api2's internal CI (credential-issuer)
# token. Generate the key the same way as the issuer key above, but the SHAPE
# here is different: ciTokenKey wants a JSON *string*, so this value is the
# FULL wrapper object serialized on one line --
#   {"type":"jwk","jwk":{"kty":"EC","crv":"P-256","d":"...","x":"...","y":"..."}}
# not a bare JWK, and not split into coordinates the way the issuer key is.
# That difference is deliberate and load-bearing: a substituted env var is
# always a HOCON string, which is exactly what this field needs and exactly
# what defaultIssuerKey.jwk must NOT get (see issuer2-profiles.conf). A bare
# JWK (missing the type/jwk wrapper) or a double-quoted value will fail HOCON
# parsing at boot with "No loaded configuration: issuer-service".
# Never commit the value. walt.id's shipped default is a private key published
# in their public repo (the same one their example issuer key comes from) and
# must not be used for anything real.
VERIFIABLY_ISSUER2_CI_TOKEN_KEY=

# EC P-256 key used to encrypt credential response payloads. Same shape
# requirement as VERIFIABLY_ISSUER2_CI_TOKEN_KEY above -- the full
# {"type":"jwk","jwk":{...}} wrapper object on one line, unquoted.
# Never commit the value. walt.id's shipped default is a distinct private key
# published in their public repo and must not be used for anything real.
VERIFIABLY_ISSUER2_CRED_ENCRYPTION_KEY=

# Optional. OIDC client secret for issuer-api2's authentication-service.conf
# (walt.id's shipped default points at their own keycloak.demo.walt.id and
# must never be used). Left blank unless that auth feature is deliberately
# enabled — nothing in _features.conf currently turns it on.
VERIFIABLY_ISSUER2_OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# walt.id issuer display name — the friendly issuer label a wallet shows when
# it reads /.well-known/openid-credential-issuer's root-level `display[]`.
# Read by BOTH issuer-api and issuer-api2 (deploy/k8s/config/issuer/ and
# .../issuer2/credential-issuer-metadata.conf's issuerDisplay block).
#
# Do not confuse with ISSUER_DISPLAY_NAME above — that variable feeds Inji
# Certify / Inji Web / CREDEBL, a completely separate set of backends from
# walt.id's issuer-api and issuer-api2.
#
# Unset means the issuerDisplay name published in the wellknown falls back
# to the literal "Issuer" rather than the wallet showing the raw issuer URL
# on its own — both walt.id images require issuerDisplay's name field to
# exist and be non-blank at boot (see the comment above issuerDisplay in
# credential-issuer-metadata.baseline.conf / issuer2's credential-issuer-
# metadata.conf for how that was verified). Requires walt.id >= 0.21 (the
# field does not exist at 0.18.2); this deployment pins 0.23.1.
VERIFIABLY_ISSUER_DISPLAY_NAME=
VERIFIABLY_ISSUER_DESCRIPTION=