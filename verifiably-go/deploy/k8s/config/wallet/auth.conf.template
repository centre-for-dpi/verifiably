# Walt.id wallet auth — symmetric and asymmetric crypto material.
#
# Security finding (Phase 0): the upstream demo committed all three keys
# inline. encryptionKey and signKey are now sourced from environment
# variables so the same file works across compose (`.env`) and K8s
# (Secrets via ESO). tokenKey stays inline for now because the JWK's
# embedded JSON quoting interacts badly with HOCON env-var substitution;
# Phase 7.1 replaces it with a Vault Transit reference, which is the
# real fix.
#
# The key is no longer committed. scripts/gen-demo-pki.sh renders this
# template with a freshly generated RSA JWK on first `deploy.sh up`, and the
# rendered auth.conf is gitignored. The key that used to live here is in the
# git history of a public repo: treat it as compromised and never reuse it.

encryptionKey = "${WALLET_ENCRYPTION_KEY}"  // 128-bit symmetric (16 ASCII chars)
signKey       = "${WALLET_SIGN_KEY}"        // 128-bit symmetric (16 ASCII chars)

# Available signing algorithms: RS256 or HS256.
# Phase 7.1: this becomes a Vault Transit key reference.
tokenKey = "__WALLET_TOKEN_JWK__"

audTokenClaim = "http://${SERVICE_HOST}:${WALLET_BACKEND_PORT}"
issTokenClaim = "http://${SERVICE_HOST}:${WALLET_BACKEND_PORT}"
tokenLifetime = "${WALLET_TOKEN_LIFETIME_DAYS}"  // days
